# DBX Enhanced - Environment Configuration Example
# Copy this file to .env and fill in your actual values
# NEVER commit .env with real secrets!

# ============================================================
# Database Connections (examples)
# ============================================================
# PostgreSQL
# DBX_PG_HOST=localhost
# DBX_PG_PORT=5432
# DBX_PG_USER=postgres
# DBX_PG_PASSWORD=your_password_here
# DBX_PG_DATABASE=your_database
# DBX_PG_SSL=true

# MySQL
# DBX_MYSQL_HOST=localhost
# DBX_MYSQL_PORT=3306
# DBX_MYSQL_USER=root
# DBX_MYSQL_PASSWORD=your_password_here
# DBX_MYSQL_DATABASE=your_database

# MongoDB
# DBX_MONGO_URI=mongodb://localhost:27017
# DBX_MONGO_DATABASE=your_database

# Redis
# DBX_REDIS_HOST=localhost
# DBX_REDIS_PORT=6379
# DBX_REDIS_PASSWORD=your_password_here
# DBX_REDIS_DB=0

# ============================================================
# African Mobile Money Providers
# ============================================================
# M-Pesa Daraja (Safaricom Kenya)
# MPESA_CONSUMER_KEY=your_consumer_key
# MPESA_CONSUMER_SECRET=your_consumer_secret
# MPESA_BUSINESS_SHORT_CODE=174379
# MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# MPESA_CALLBACK_URL=https://your-domain.com/callback
# MPESA_ENVIRONMENT=sandbox  # or production

# MTN MoMo
# MTN_MOMO_API_USER=your_api_user
# MTN_MOMO_API_KEY=your_api_key
# MTN_MOMO_SUBSCRIPTION_KEY=your_subscription_key
# MTN_MOMO_ENVIRONMENT=sandbox  # or production

# Airtel Money
# AIRTEL_MONEY_CLIENT_ID=your_client_id
# AIRTEL_MONEY_CLIENT_SECRET=your_client_secret
# AIRTEL_MONEY_ENVIRONMENT=sandbox  # or production

# ============================================================
# African Banking Systems
# ============================================================
# NIBSS (Nigeria)
# NIBSS_API_KEY=your_api_key
# NIBSS_API_SECRET=your_api_secret
# NIBSS_PARTICIPANT_CODE=your_participant_code
# NIBSS_CERTIFICATE_PATH=/path/to/cert.pem
# NIBSS_CERTIFICATE_PASSWORD=your_cert_password

# Pesalink (Kenya)
# PESALINK_API_KEY=your_api_key
# PESALINK_API_SECRET=your_api_secret

# GHIPSS (Ghana)
# GHIPSS_API_KEY=your_api_key
# GHIPSS_API_SECRET=your_api_secret

# ============================================================
# Healthcare Systems
# ============================================================
# DHIS2
# DHIS2_BASE_URL=https://your-dhis2-instance.org
# DHIS2_USERNAME=your_username
# DHIS2_PASSWORD=your_password
# DHIS2_API_VERSION=api

# OpenMRS
# OPENMRS_BASE_URL=https://your-openmrs-instance.org
# OPENMRS_USERNAME=your_username
# OPENMRS_PASSWORD=your_password
# OPENMRS_DATABASE_NAME=openmrs

# ============================================================
# AI Providers (for dbx-ai-provider)
# ============================================================
# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI
# OPENAI_API_KEY=sk-your_key_here

# Ollama (local)
# OLLAMA_BASE_URL=http://localhost:11434

# Generic OpenAI-compatible
# OPENAI_COMPATIBLE_BASE_URL=https://api.example.com/v1
# OPENAI_COMPATIBLE_API_KEY=your_key_here

# ============================================================
# MCP Server Configuration
# ============================================================
# Transport: stdio | streamable-http
# DBX_MCP_TRANSPORT=stdio

# HTTP/SSE Transport (when using streamable-http)
# DBX_MCP_HTTP_PORT=3000
# DBX_MCP_HTTP_HOST=0.0.0.0
# DBX_MCP_HTTP_CORS_ORIGINS=https://claude.ai,https://cursor.sh

# Web Backend (for dbx-web mode)
# DBX_WEB_URL=https://your-dbx-web-instance.com
# DBX_WEB_PASSWORD=your_web_password

# ============================================================
# Logging & Debugging
# ============================================================
# RUST_LOG=debug,dbx_mcp=info,dbx_core=info
# DBX_LOG_LEVEL=info

# ============================================================
# Benchmark Configuration
# ============================================================
# DBX_BENCH_ITERATIONS=100
# DBX_BENCH_WARMUP=10
# DBX_BENCH_REGRESSION=true
# DBX_BENCH_THRESHOLD=10.0
# DBX_BENCH_OUTPUT_DIR=bench-results
# DBX_BENCH_BASELINE=bench-results/baseline.json